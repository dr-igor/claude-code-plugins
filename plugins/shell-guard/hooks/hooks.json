{
  "description": "Pre-checks Bash commands and auto-rejects known-annoying patterns",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/shell-guard\""
          }
        ]
      }
    ]
  }
}
