{
  "description": "Denies every Bash permission prompt so an unattended session keeps working, and logs what was blocked",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/away-mode-deny.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
